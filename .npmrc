# Reproducible, supply-chain-conscious pnpm defaults.
save-exact=true
save-prefix=
manage-package-manager-versions=true
auto-install-peers=true
strict-peer-dependencies=false

# vite-plus ships its compiler as a NAPI native addon split into per-platform
# optionalDependencies (@voidzero-dev/vite-plus-<os>-<arch>). pnpm's default
# isolated linker does not place that addon where vite-plus's binding loader
# can `require()` it, so `vp` fails with "Cannot find module
# '@voidzero-dev/vite-plus-darwin-...'". Hoisting fixes the resolution.
node-linker=hoisted
